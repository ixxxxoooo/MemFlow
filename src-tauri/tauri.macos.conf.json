{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MemFlow",
        "url": "index.html",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      },
      {
        "label": "capsule",
        "title": "MemFlow 闪念",
        "url": "capsule.html",
        "width": 640,
        "height": 62,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": true,
        "visibleOnAllWorkspaces": true,
        "focus": true
      },
      {
        "label": "toast",
        "title": "MemFlow 提示",
        "url": "toast.html",
        "width": 260,
        "height": 52,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "focusable": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 640,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 190
        }
      }
    }
  }
}
